# ==========================================
# Lendora Root .gitignore
# ==========================================

# --- Python & Byte-compiled / optimized files ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/env/
ml/venv/
ml/env/
.venv/

# --- Unit test / coverage / linters ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Environment variables & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key

# --- Node.js & Frontend (Next.js) ---
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Machine Learning large artifacts & checkpoints ---
*.h5
*.tflite
*.pt
*.pth
*.ckpt
*.onnx
# Note: Keep placeholder directories or tracked benchmarks, ignore heavy binary weights
ml/checkpoints/
ml/wandb/
wandb/

# --- IDEs & Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Logs & Databases ---
*.log
*.sqlite
*.sqlite3
*.db
